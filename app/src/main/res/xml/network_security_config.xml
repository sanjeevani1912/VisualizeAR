<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is denied by default (Android 9+ behaviour, asserted explicitly here).

  The self-hosted India map server currently serves plain HTTP only: its 8443 listener is
  published but has no certificate, so the TLS handshake fails. Until that is fixed server-side
  the exception below is required for tiles, glyphs and /search to load.

  Scope it per host. Do NOT set android:usesCleartextTraffic="true" on <application> — that would
  permit downgraded connections to every destination the app ever talks to.

  Remove the domain entry once the map server terminates TLS.
  See docs/Map-Server-Configuration.md and docs/Map-Server-Handover-Notes.md.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Hosts allowed plain HTTP. localhost = a phone on USB with `adb reverse tcp:8000 tcp:8000`
         (traffic stays on the cable). For a Wi-Fi/LAN PC address Android takes no wildcards:
         add one <domain> line with that exact address and rebuild, or use the debug build.
         See docs/APP-PHONE-TEST.md. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Android emulator alias for a server running on the development machine itself -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
