# Copy to deploy/.env (git-ignored) and replace every CHANGE_ME. Never commit deploy/.env.
# deploy/make-env.ps1 (or make-env.sh) does this for you with random values.
POSTGRES_DB=dhruvar
POSTGRES_USER=dhruvar
POSTGRES_PASSWORD=CHANGE_ME
DJANGO_SECRET_KEY=CHANGE_ME
# Extra address a phone/PC on the network uses to reach this PC (comma separated is fine). Django refuses
# requests whose Host is not listed (localhost and 127.0.0.1 are always allowed).
LAN_HOST=192.168.1.42
# Which Nginx routing file to use: stack.conf (Django, normal) or fallback-node.conf (old Node API on host port 4000)
NGINX_CONF=./nginx/stack.conf
